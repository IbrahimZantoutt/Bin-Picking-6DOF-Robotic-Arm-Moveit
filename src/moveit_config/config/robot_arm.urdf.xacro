<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <!-- Set to true when launching in Gazebo (see gazebo.launch.py). Leave false for the RViz demo. -->
    <xacro:arg name="use_gazebo" default="false" />

    <!-- Import robot_arm urdf file -->
    <xacro:include filename="$(find bin_nodes)/urdf/robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="robot_arm.ros2_control.xacro" />


    <xacro:robot_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)" use_gazebo="$(arg use_gazebo)"/>

    <!-- Gazebo-only: anchor the base to the world frame and load the ros2_control plugin. -->
    <xacro:if value="$(arg use_gazebo)">
        <link name="world"/>
        <joint name="world_fixed" type="fixed">
            <parent link="world"/>
            <child link="robot_base"/>
        </joint>

        <gazebo>
            <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                <parameters>$(find moveit_config)/config/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>
